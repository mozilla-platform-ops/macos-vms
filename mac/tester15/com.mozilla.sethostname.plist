<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mozilla.sethostname</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/set_hostname.sh</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- Without these, everything set_hostname.sh says is lost. The script
         failing part-way through (leaving a clone on the image's baked workerId)
         was invisible for exactly this reason; the script now also keeps its own
         /var/log/set_hostname.log. -->
    <key>StandardOutPath</key>
    <string>/var/log/set_hostname.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/set_hostname.launchd.log</string>
</dict>
</plist>